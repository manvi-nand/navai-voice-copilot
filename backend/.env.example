# Copy to .env and fill in. With USE_MOCKS=true (default) everything runs offline.

# Master switch — true = canned responses, no external calls, no keys needed.
USE_MOCKS=true
ENVIRONMENT=dev

# --- LLM: Gemini 2.5 Flash (https://aistudio.google.com/apikey) ---
# When set, the real LangGraph ReAct agent runs; otherwise an offline heuristic does.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Sarvam AI (STT saaras:v3 + TTS) — https://dashboard.sarvam.ai ---
SARVAM_API_KEY=

# --- Google Maps Platform — enable Routes API, Places API (New), Geocoding API,
#     and Weather API on this key. Falls back to GOOGLE_API_KEY if left blank.
GOOGLE_MAPS_API_KEY=

# --- OpenWeatherMap — no longer used (weather now uses the Google Weather API).
#     Kept only for optional fallback; safe to leave blank.
OPENWEATHER_API_KEY=

# --- LiveKit (self-hosted via docker-compose for dev) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Tuning ---
VAD_SILENCE_MS=800          # try 1000-1200 for in-car road noise (doc §8)
SESSION_TTL_MINUTES=30
